# Additional choices inside KSHIM_MENU_STYLE; no native toolkits or brand assets.
config KSHIM_MENU_STYLE_METRO
    bool "METRO - typography-led Windows Phone inspired page"
    help
        Large left-aligned typography, an unframed black page, a distinct
        selection mark and an outlined local action. No live tiles or fake apps.
config KSHIM_MENU_STYLE_ONE_UI
    bool "ONE_UI - portrait viewing and lower interaction areas"
    help
        Large portrait viewing area above a reachable selection group and
        Boot action. Long lists expand upward; landscape uses a compact group.
        Focus movement never rearranges the controls or confirms a boot.
config KSHIM_MENU_STYLE_ADWAITA
    bool "ADWAITA - GNOME inspired boxed selection list"
    help
        Centered header bar, symbolic media marks, a continuous boxed list
        and an independent suggested action. No GTK dependency or fake controls.
config KSHIM_MENU_STYLE_HOLO
    bool "HOLO - Android 4.x inspired dark action-bar list"
    help
        Flat dark surfaces, cyan action-bar rule, row separators and radio
        selection marks. Uses the shared font and input/Boot state machine.
