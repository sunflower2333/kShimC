# Qualcomm SM8650 QRD: mainline sm8650-qrd.dts as the runtime DT; see
# configs/qrd8650-provenance.json. UEFI reference port: LanaiCrPkg (qcom-qrd8650),
# CrDK Target/Sm8650 (GPIO, PDC, inherited UART15 console).
# Console: uart15 (serial0, 0x89c000) inherited from the boot chain.
# Keys: PMK8550 PON gen3 power/resin (vol-) and pm8550_gpios 6 (vol+).
# Touch: Goodix GT9916 (Berlin) on spi4.
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
CONFIG_KSHIM_LVGL_BUFFER_BYTES=262144
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
CONFIG_ASSERT_HALT=y

CONFIG_KSHIM_SMP=y
CONFIG_KSHIM_SMP_WORKERS=7
# Pointer service for the LVGL menu; the touch driver comes with GT9916.
CONFIG_KSHIM_TOUCH=y

# I/O stack (docs/io-stack.md): GT9916 on spi4 through the QUP/GENI SPI
# controller, rails and pads through the SM8650 platform layer. With the LVGL
# menu this profile no longer fits the 4 MiB Manifest slot ("kShim runtime
# exceeds image slot"); slot size is not treated as a blocker, every symbol
# resolves (checked with a larger scratch slot).
CONFIG_KSHIM_REGULATOR=y
CONFIG_KSHIM_QUP=y
CONFIG_KSHIM_SPI=y
CONFIG_KSHIM_TOUCH_GT9916=y
# Full I/O stack: 8 MiB runtime slot (advertised in the Image header).
CONFIG_KSHIM_RUNTIME_SLOT_SIZE=0x800000
