# AYANEO Pocket S2 / S2 Pro (SM8650): mainline sm8650-ayaneo-pocket-s2.dts as
# the runtime DT, plus the RFC touch node; see configs/ayaneo-pocket-s2-provenance.json.
# Console: uart15 (serial0, 0x89c000) inherited from the boot chain.
# Keys: PMK8550 PON gen3 power/resin (vol-) and pm8550_gpios 6 (vol+).
# Gamepad: pcie1 -> uPD720201 xHCI -> USB HID; touch: GT911 on i2c4.
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
CONFIG_KSHIM_LVGL_BUFFER_BYTES=262144
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
CONFIG_ASSERT_HALT=y

CONFIG_KSHIM_SMP=y
CONFIG_KSHIM_SMP_WORKERS=7
# Pointer service for the LVGL menu; the touch driver comes with GT911.
CONFIG_KSHIM_TOUCH=y

# I/O stack (docs/io-stack.md). With the LVGL menu this profile no longer
# fits the 4 MiB Manifest slot ("kShim runtime exceeds image slot"); slot
# size is not treated as a blocker, every symbol resolves (checked with a
# larger scratch slot).
# Storage for renesas_usb_fw.mem: super/vendor{slot}/firmware first, then
# super/odm and vendor_dlkm, then persist and the efisp ESP (docs/usb.md).
# An EROFS vendor partition needs CONFIG_FS_EROFS (GPL-2.0 opt-in, left off
# here); it is then skipped and the other locations are tried. FAT reads the
# efisp ESP and modem{slot}.
CONFIG_BLOCK=y
CONFIG_BLK_UFS=y
CONFIG_FS_EXT4=y
CONFIG_FS_F2FS=y
CONFIG_FS_FAT=y
CONFIG_FIRMWARE_LOADER=y
# Platform layer (gpio, pinctrl, clk, regulators).
CONFIG_KSHIM_REGULATOR=y
# Gamepad: pcie1 -> uPD720201 xHCI (Renesas firmware) -> USB HID.
CONFIG_KSHIM_PCI=y
CONFIG_KSHIM_PCI_QCOM=y
CONFIG_KSHIM_USB=y
CONFIG_KSHIM_USB_XHCI=y
CONFIG_KSHIM_USB_XHCI_RENESAS=y
CONFIG_KSHIM_USB_HUB=y
CONFIG_KSHIM_USB_HID=y
# Touch: GT911 on i2c4 (RFC node).
CONFIG_KSHIM_QUP=y
CONFIG_KSHIM_I2C=y
CONFIG_KSHIM_TOUCH_GT911=y
# Full I/O stack: 8 MiB runtime slot (advertised in the Image header).
CONFIG_KSHIM_RUNTIME_SLOT_SIZE=0x800000
