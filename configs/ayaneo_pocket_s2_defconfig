# AYANEO Pocket S2 / S2 Pro (SM8650): mainline sm8650-ayaneo-pocket-s2.dts as
# the runtime DT, plus the RFC touch node; see configs/ayaneo-pocket-s2-provenance.json.
# Console: uart15 (serial0, 0x89c000) inherited from the boot chain.
# Keys: PMK8550 PON gen3 power/resin (vol-) and pm8550_gpios 6 (vol+).
# Gamepad: pcie1 -> uPD720201 xHCI -> USB HID; touch: GT911 on i2c4.
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
CONFIG_KSHIM_LVGL_BUFFER_BYTES=262144
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
CONFIG_ASSERT_HALT=y

CONFIG_KSHIM_SMP=y
CONFIG_KSHIM_SMP_WORKERS=7
# Pointer service for the LVGL menu; the touch driver comes with GT911.
CONFIG_KSHIM_TOUCH=y

# Not enabled yet: with the LVGL menu the 4 MiB Manifest slot has about
# 8 KiB left on this profile. Storage plus the firmware loader overflows it
# by ~80 KiB and the platform layer alone (CONFIG_KSHIM_REGULATOR=y) by
# ~8-45 KiB ("kShim runtime exceeds image slot"). Enable once the slot
# question is settled:
#   storage for renesas_usb_fw.mem (super/vendor{slot}/firmware; an EROFS
#   vendor partition needs CONFIG_FS_EROFS, GPL-2.0 opt-in):
#                 CONFIG_BLOCK=y  CONFIG_BLK_UFS=y  CONFIG_FS_EXT4=y
#                 CONFIG_FS_F2FS=y  CONFIG_FIRMWARE_LOADER=y
#   sm8650:       CONFIG_KSHIM_REGULATOR=y
#   qup:          CONFIG_KSHIM_QUP=y  CONFIG_KSHIM_I2C=y
#   pci:          CONFIG_KSHIM_PCI=y  CONFIG_KSHIM_PCI_QCOM=y
#   xhci:         CONFIG_KSHIM_USB=y  CONFIG_KSHIM_USB_XHCI=y  CONFIG_KSHIM_USB_XHCI_RENESAS=y
#   usbhid:       CONFIG_KSHIM_USB_HUB=y  CONFIG_KSHIM_USB_HID=y
#   touch-goodix: CONFIG_KSHIM_TOUCH_GT911=y
