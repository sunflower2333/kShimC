CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
# HDK8450's display is DSI -> LT9611 HDMI bridge, brought up natively by
# mu_aloha's DisplayCrDxe; ABL leaves no scanout and MDSS may be
# power-collapsed, so reading the MDP registers hangs the bus.
# CONFIG_KSHIM_SPLASH_SCANOUT is not set
CONFIG_KSHIM_LVGL=y
CONFIG_KSHIM_LVGL_BUFFER_BYTES=262144
CONFIG_KSHIM_UEFI_TEST_MENU=y
CONFIG_KSHIM_MENU_ENTRY1="UEFI A"
CONFIG_KSHIM_MENU_ENTRY2="UEFI B"
CONFIG_KSHIM_UEFI_LOAD_ADDRESS=0xFFC00000
CONFIG_KSHIM_UEFI_MAX_SIZE=0x400000
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
CONFIG_ASSERT_HALT=y

CONFIG_KSHIM_SMP=y
CONFIG_KSHIM_SMP_WORKERS=7
# DT index + I/O stack: 8 MiB runtime slot (advertised in the Image header).
CONFIG_KSHIM_RUNTIME_SLOT_SIZE=0x800000
