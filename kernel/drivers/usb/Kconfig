# Owner: xhci (docs/io-stack.md). Class drivers: usb/class/Kconfig (usbhid).

config KSHIM_USB
    bool "USB host core"
    default n
    help
        USB device model, enumeration, control/bulk/interrupt transfers with
        completion callbacks and a class-driver registry (kshim/usb.h,
        kshim/usb_hcd.h). Host controllers are stopped and reset before
        payload handoff.

config KSHIM_DMA_POOL_SIZE
    hex "DMA pool size for bus-master devices"
    depends on KSHIM_USB
    default 0x40000
    help
        Static, page-aligned pool in the runtime image (kshim/dma.h) for the
        xHCI rings, device contexts, scratchpads, transfer bounce buffers
        and the Renesas firmware image while it is downloaded. About 8 KiB
        per enumerated device plus the controller's scratchpad pages.

config KSHIM_USB_XHCI
    bool "xHCI host controllers on PCI"
    depends on KSHIM_USB && KSHIM_PCI
    default n
    help
        xHCI 1.x driver for PCI class 0x0c0330 functions (QEMU qemu-xhci and
        nec-usb-xhci, Renesas uPD720201/uPD720202). Interrupt-driven through
        the PCI core (INTx/MSI) with event-ring polling as the fallback.
        A controller left running by the previous firmware is taken over
        after a clean halt and reset.

config KSHIM_USB_XHCI_FORCE_POLL
    bool "Poll the xHCI event ring instead of using its interrupt"
    depends on KSHIM_USB_XHCI
    default n
    help
        Bring-up and test aid: never request the PCI interrupt, so every
        event is found by the polling fallback.

config KSHIM_USB_XHCI_RENESAS
    bool "Renesas uPD720201/uPD720202 firmware download"
    depends on KSHIM_USB_XHCI
    default n
    help
        Download the controller firmware unless an external ROM is present
        or the firmware already runs. The image is read with the Android
        firmware loader (CONFIG_FIRMWARE_LOADER); without the loader only
        the ROM and already-running cases work.

config KSHIM_USB_XHCI_RENESAS_FW
    string "Renesas firmware file name"
    depends on KSHIM_USB_XHCI_RENESAS
    default "renesas_usb_fw.mem"

config KSHIM_USB_XHCI_RENESAS_FW_EMBED
    string "Optional Renesas firmware image to link into the runtime"
    depends on KSHIM_USB_XHCI_RENESAS
    default ""
    help
        Path, at build time, of a firmware image to embed. Empty (the
        default) embeds nothing. When set, the embedded image is used
        whenever the controller needs firmware (after "already running" and
        the external ROM) and no partition is read. The image is Renesas'
        proprietary firmware: never commit it, and do not redistribute a
        runtime that embeds it unless Renesas' terms allow it.

config KSHIM_USB_SELFTEST
    bool "USB core self-test class driver (QEMU test)"
    depends on KSHIM_USB
    default n
    help
        Binds HID interfaces, fetches their report descriptor, submits an
        interrupt-IN URB and logs reports; kshim_usb_settle() then waits up
        to KSHIM_USB_SELFTEST_MS for two reports. Test builds only.

config KSHIM_USB_SELFTEST_MS
    int "Self-test report wait (ms)"
    depends on KSHIM_USB_SELFTEST
    default 5000
